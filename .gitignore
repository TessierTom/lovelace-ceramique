# ═══════════════════════════════════════
# Environnement (NE JAMAIS COMMITTER)
# ═══════════════════════════════════════
.env
.env.local
.env.*.local
# .env.example est intentionally tracked

# ═══════════════════════════════════════
# Frontend — Node / Vite
# ═══════════════════════════════════════
node_modules/
dist/
dist-ssr/
.vite/
*.local

# Lock : on garde package-lock.json (stabilité équipe)
# → ne pas ignorer

# ═══════════════════════════════════════
# Backend — PHP / Composer
# ═══════════════════════════════════════
backend/vendor/
*.phar
.phpunit.result.cache

# ═══════════════════════════════════════
# Base de données locale
# ═══════════════════════════════════════
*.sqlite
*.sqlite3
*.db
dump.sql
pg_dump*.sql

# ═══════════════════════════════════════
# Docker — volumes locaux (hors compose)
# ═══════════════════════════════════════
docker/volumes/
docker/data/
docker/.env

# ═══════════════════════════════════════
# Logs
# ═══════════════════════════════════════
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

